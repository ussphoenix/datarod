{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": false },
  "formatter": {
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // tailwind class sorting is still in development:
      // https://github.com/biomejs/biome/issues/1274
      "nursery": {
        "useSortedClasses": {
          "level": "off", // keeping off until consistent state
          "options": {
            "attributes": ["className"],
            "functions": ["clsx", "twMerge", "cn"]
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "selfCloseVoidElements": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react"],
              ":BLANK_LINE:",
              [":NODE:", ":PACKAGE:", ":ALIAS:"],
              ":BLANK_LINE:",
              [":PATH:", "!**/*.css"],
              ":BLANK_LINE:",
              ["**/*.css"]
            ]
          }
        }
      }
    }
  }
}
